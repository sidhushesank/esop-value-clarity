generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PlanType {
  FREE
  PRO
}

enum BillingCycle {
  MONTHLY
  SIX_MONTHS
  YEARLY
  TEAM_YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum SubscriptionSource {
  PAYMENT
  ADMIN_GRANT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================================
// B2B TEAM WORKSPACE
// ============================================================

enum TeamWorkspaceStatus {
  ACTIVE
  EXPIRED
}

enum TeamMembershipStatus {
  ACTIVE
  REMOVED
}

enum EsopDocumentStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
  DELETED
}

enum EsopDocumentSource {
  UPLOAD
  MANUAL
}

enum EsopGrantStatus {
  DRAFT
  REVIEW_REQUIRED
  CONFIRMED
  ARCHIVED
}

enum EsopFieldStatus {
  VERIFIED
  REVIEW
  NOT_FOUND
  USER_CONFIRMED
}

enum EsopVestingFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
  UNKNOWN
}

enum EsopClauseType {
  TERMINATION
  EXERCISE_WINDOW
  FORFEITURE
  CHANGE_OF_CONTROL
  ACCELERATION
  EXPIRY
  VESTING
  TRANSFER_RESTRICTION
  REPURCHASE
  LIQUIDITY
  TAX
  OTHER
}

enum EsopClauseImportance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserActivityType {
  LOGIN
  LOGOUT
  SIGNUP
  PROFILE_UPDATED
  SIMULATOR_USED
  TAX_CALCULATED
  DILUTION_CALCULATED
  VESTING_CALCULATED
  EXIT_CALCULATED
  COMPARE_USED
  REPORT_CREATED
  CALCULATION_CREATED
  CALCULATION_UPDATED
  CALCULATION_DELETED
  PRO_UPGRADED
  PRO_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED

  ESOP_DOCUMENT_UPLOADED
  ESOP_DOCUMENT_PROCESSING_STARTED
  ESOP_DOCUMENT_PROCESSED
  ESOP_DOCUMENT_REVIEWED
  ESOP_DOCUMENT_CONFIRMED
  ESOP_DOCUMENT_FAILED
  ESOP_DOCUMENT_DELETED
  ESOP_GRANT_CREATED
  ESOP_GRANT_UPDATED
  ESOP_GRANT_CONFIRMED
  ESOP_GRANT_ARCHIVED
}

enum AdminActionType {
  USER_VIEWED
  PRO_GRANTED
  PRO_REVOKED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_DELETED
  ROLE_CHANGED
  TEAM_TERM_EXTENDED
  ADVISOR_FIRM_GRANTED
  ADVISOR_FIRM_EXTENDED
  ADVISOR_FIRM_UPDATED
  ADVISOR_FIRM_REVOKED
}

// ============================================================
// ADVISOR CONSOLE ENUMS
// ============================================================

enum AdvisorFirmStatus {
  ACTIVE
  EXPIRED
}

enum ClientCompanyType {
  PRIVATE_LIMITED
  UNLISTED_PUBLIC
}

enum ResolutionKind {
  BOARD_SCHEME_APPROVAL
  SHAREHOLDER_SCHEME_APPROVAL
}

enum ResolutionVote {
  ORDINARY
  SPECIAL
}

enum HolderType {
  FOUNDER
  INVESTOR
  ESOP_POOL
  OTHER
}

enum RegisterGrantStatus {
  ACTIVE
  LAPSED
  LEFT
  FULLY_EXERCISED
}

enum ImportKind {
  REGISTER
  CAP_TABLE
}

enum FindingSeverity {
  RED
  AMBER
  GREEN
  INFO
}

// ============================================================
// TAX-EVENT LEDGER ENUMS
// ============================================================

enum TaxEventType {
  EXERCISE
  SALE
  LEAVE
  BUYBACK
}

enum TaxRegime {
  NEW
  OLD
}

enum ReminderStatus {
  SENT
  FAILED
}

// ============================================================
// B2B TEAM WORKSPACE
// ============================================================
//
// Separate entitlement from the personal FREE / PRO subscription.
// Application rules:
// - One workspace per purchaser.
// - One annual entitlement per workspace.
// - Maximum 20 active members.
// - Members must already have registered EVC accounts.
// - Active members receive Team-sponsored PRO access.
// - Members do not receive Team Admin functionality.
// ============================================================

model TeamWorkspace {
  id String @id @default(cuid())

  name String

  ownerId String @unique
  owner   User   @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  status TeamWorkspaceStatus @default(ACTIVE)

  startedAt DateTime @default(now())
  expiresAt DateTime

  members  TeamMembership[]
  payments TeamPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model TeamMembership {
  id String @id @default(cuid())

  workspaceId String
  workspace   TeamWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TeamMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  status TeamMembershipStatus @default(ACTIVE)

  addedAt   DateTime  @default(now())
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model TeamPayment {
  id String @id @default(cuid())

  workspaceId String
  workspace   TeamWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  startedAt DateTime @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================================
// PHASE 4 — OFFER INTELLIGENCE
// ============================================================

enum OfferIntelligenceStatus {
  DRAFT
  REVIEW_REQUIRED
  CONFIRMED
  ARCHIVED
}

enum OfferIntelligenceSource {
  PDF_UPLOAD
  MANUAL
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  passwordHash  String
  emailVerified Boolean @default(true)

  role          UserRole      @default(USER)
  accountStatus AccountStatus @default(ACTIVE)

  lastLoginAt  DateTime?
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calculations      Calculation[]
  proWaitlist       ProWaitlist?
  verificationToken EmailVerificationToken?

  subscription Subscription?
  payments     Payment[]

  activities UserActivity[]

  // ============================================================
  // B2B TEAM WORKSPACE
  // ============================================================

  ownedTeamWorkspace TeamWorkspace?   @relation("TeamOwner")
  teamMemberships    TeamMembership[] @relation("TeamMembershipUser")
  teamPayments       TeamPayment[]

  // ============================================================
  // ADVISOR CONSOLE
  // ============================================================

  ownedAdvisorFirm AdvisorFirm?     @relation("AdvisorOwner")
  advisorPayments  AdvisorPayment[] @relation("AdvisorPaymentUser")

  adminActions    AdminAuditLog[] @relation("AdminActor")
  adminTargetLogs AdminAuditLog[] @relation("AdminTarget")

  esopDocuments EsopDocument[]
  esopGrants    EsopGrant[]

  // ============================================================
  // PHASE 4 — OFFER INTELLIGENCE
  // ============================================================

  offerIntelligenceRecords OfferIntelligence[]
}

model GuestSession {
  id         String   @id @default(cuid())
  guestId    String   @unique
  usageCount Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Calculation {
  // ============================================================
  // EXISTING CALCULATION FIELDS
  // ============================================================

  id                 String @id @default(cuid())
  esopsGranted       Int
  vestedPercentage   Float
  currentValuation   Float
  dilutionPercentage Float
  exitValuation      Float
  vestedShares       Float
  valueToday         Float
  afterDilution      Float
  exitValue          Float

  // ============================================================
  // NEW PRO SIMULATOR INPUTS
  // ============================================================

  totalShares Float @default(10000000)
  strikePrice Float @default(0)

  // ============================================================
  // NEW PRO SIMULATOR RESULTS
  // ============================================================

  unvestedShares      Float @default(0)
  ownershipPercentage Float @default(0)
  currentSharePrice   Float @default(0)

  grossValueToday Float @default(0)
  exerciseCost    Float @default(0)
  netValueToday   Float @default(0)

  grossExitValue  Float @default(0)
  dilutionImpact  Float @default(0)
  netExitProceeds Float @default(0)

  returnMultiple         Float @default(0)
  roiPercentage          Float @default(0)
  breakEvenExitValuation Float @default(0)

  // ============================================================
  // SAVED PRO ANALYSIS
  // ============================================================

  name String?

  // ============================================================
  // EXISTING USER RELATION
  // ============================================================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ============================================================
  // TIMESTAMPS
  // ============================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProWaitlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  plan         PlanType           @default(FREE)
  billingCycle BillingCycle?
  status       SubscriptionStatus @default(ACTIVE)

  source SubscriptionSource @default(PAYMENT)

  grantedById String?
  grantReason String?

  startedAt DateTime  @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id String @id @default(cuid())

  userId String

  plan         PlanType
  billingCycle BillingCycle

  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserActivity {
  id String @id @default(cuid())

  userId String
  type   UserActivityType

  metadata Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model AdminAuditLog {
  id           String          @id @default(cuid())
  adminId      String
  targetUserId String?
  action       AdminActionType
  metadata     Json?
  createdAt    DateTime        @default(now())

  admin      User  @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model EsopDocument {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source EsopDocumentSource @default(UPLOAD)
  status EsopDocumentStatus @default(UPLOADED)

  originalFileName String?
  storageKey       String?
  mimeType         String?
  fileSizeBytes    Int?

  extractedText   Json?
  extractionData  Json?
  extractionError String?

  processingStartedAt DateTime?
  processedAt         DateTime?
  confirmedAt         DateTime?
  deletedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants  EsopGrant[]
  clauses EsopDocumentClause[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EsopGrant {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?
  document   EsopDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  status EsopGrantStatus @default(DRAFT)

  companyName String?
  grantName   String?

  grantDate DateTime?

  optionCount Int?

  strikePrice Float?
  currency    String @default("INR")

  vestingStartDate      DateTime?
  vestingDurationMonths Int?
  cliffMonths           Int?

  vestingFrequency EsopVestingFrequency @default(UNKNOWN)

  expiryDate DateTime?

  postTerminationExerciseDays Int?

  notes String?

  confirmedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields EsopGrantField[]

  @@index([userId])
  @@index([documentId])
  @@index([status])
  @@index([companyName])
  @@index([createdAt])
}

model EsopGrantField {
  id String @id @default(cuid())

  grantId String
  grant   EsopGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  fieldKey String
  label    String

  extractedValue Json?
  confirmedValue Json?

  status EsopFieldStatus @default(REVIEW)

  sourceText String?
  sourcePage Int?

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([grantId, fieldKey])
  @@index([grantId])
  @@index([status])
}

model EsopDocumentClause {
  id String @id @default(cuid())

  documentId String
  document   EsopDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type       EsopClauseType
  importance EsopClauseImportance @default(MEDIUM)

  title   String
  summary String?

  extractedText String?

  fieldStatus EsopFieldStatus @default(REVIEW)

  sourcePage Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([type])
  @@index([importance])
}

// ============================================================
// PHASE 4 — OFFER INTELLIGENCE
//
// Separate from EsopGrant because an employment offer can be:
//
// - Cash only
// - Cash + ESOP
// - Cash + RSU
// - Cash + other equity
//
// This model stores the employee-confirmed offer used by the
// Phase 4 comparison / negotiation engines.
// ============================================================

model OfferIntelligence {
  id String @id @default(cuid())

  // ============================================================
  // OWNERSHIP
  // ============================================================

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ============================================================
  // LIFECYCLE
  // ============================================================

  status OfferIntelligenceStatus @default(DRAFT)
  source OfferIntelligenceSource @default(PDF_UPLOAD)

  // ============================================================
  // OFFER / EMPLOYER IDENTITY
  // ============================================================

  companyName String?
  roleTitle   String?
  location    String?

  employmentType String?
  workMode       String?

  joiningDate DateTime?

  currency String @default("INR")

  // ============================================================
  // CASH COMPENSATION
  // ============================================================

  headlineCTC Float?
  fixedSalary Float?

  basicSalary      Float?
  hra              Float?
  specialAllowance Float?

  otherFixedAllowance Float?

  targetVariablePay  Float?
  maximumVariablePay Float?

  joiningBonus     Float?
  retentionBonus   Float?
  relocationBonus  Float?
  performanceBonus Float?

  employerPF Float?
  gratuity   Float?

  insuranceValue        Float?
  otherEmployerBenefits Float?

  // ============================================================
  // EQUITY
  // ============================================================

  equityType String?

  companyEquityStatus String?

  employerHeadlineEquityValue Float?

  totalOptionsOrShares Int?

  exercisePrice Float?
  currentFMV    Float?

  listedSharePrice Float?

  companyValuation    Float?
  totalCompanyShares  Float?
  ownershipPercentage Float?

  vestingDurationMonths Int?
  cliffMonths           Int?
  vestingFrequency      String?

  vestingStartDate DateTime?
  grantDate        DateTime?
  expiryDate       DateTime?

  postTerminationExerciseDays Int?

  expectedDilutionPercentage Float?

  // ============================================================
  // SOURCE DOCUMENT METADATA
  //
  // We intentionally do NOT persist the uploaded PDF itself
  // in Offer Intelligence V1.
  //
  // The PDF is used for local extraction and discarded after
  // the scan request. Only metadata and reviewed structured
  // information are persisted.
  // ============================================================

  originalFileName String?
  mimeType         String?
  fileSizeBytes    Int?
  pageCount        Int?

  // ============================================================
  // REVIEW / AUDIT SNAPSHOTS
  // ============================================================

  rawScanSnapshot       Json?
  confirmedScanSnapshot Json?
  normalizedSnapshot    Json?
  validationSnapshot    Json?

  // ============================================================
  // CONFIRMATION
  // ============================================================

  confirmedAt DateTime?
  archivedAt  DateTime?

  // ============================================================
  // TIMESTAMPS
  // ============================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ============================================================
  // INDEXES
  // ============================================================

  @@index([userId])
  @@index([status])
  @@index([companyName])
  @@index([createdAt])
}

// ============================================================
// ADVISOR CONSOLE
// ============================================================

model AdvisorFirm {
  id String @id @default(cuid())

  name String

  ownerId String @unique
  owner   User   @relation("AdvisorOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  status      AdvisorFirmStatus @default(ACTIVE)
  clientLimit Int               @default(10)

  source      SubscriptionSource @default(PAYMENT)
  grantedById String?
  grantReason String?

  startedAt DateTime @default(now())
  expiresAt DateTime

  brandName   String?
  brandFooter String?

  // Tax-Event Ledger: where deadline reminders go (defaults to the owner's email)
  reminderEmail String?

  clients  ClientCompany[]
  payments AdvisorPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])

  paymentReference String?
  expiryReminderFor DateTime?
}

model AdvisorPayment {
  id String @id @default(cuid())

  firmId String
  firm   AdvisorFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("AdvisorPaymentUser", fields: [userId], references: [id], onDelete: Cascade)

  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  startedAt DateTime @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
  @@index([userId])
  @@index([status])
}

model ClientCompany {
  id String @id @default(cuid())

  firmId String
  firm   AdvisorFirm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  name        String
  cin         String?
  companyType ClientCompanyType @default(PRIVATE_LIMITED)

  incorporationDate DateTime?
  approvedPoolSize  Int?

  dpiitRecognised Boolean?
  imbCertificate  Boolean?
  overseasParent  Boolean?

  archivedAt DateTime?

  resolutions ClientResolution[]
  valuations  ClientValuation[]
  batches     ImportBatch[]
  grants      RegisterGrant[]
  exercises   RegisterExercise[]
  capTable    CapTableRow[]
  runs        DiligenceRun[]
  shareLinks  ShareLink[]

  taxEmployees    TaxEmployee[]
  taxEvents       TaxEvent[]
  taxComputations TaxComputation[]
  reminderLogs    TaxReminderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
  @@index([archivedAt])
}

model ClientResolution {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind ResolutionKind
  vote ResolutionVote

  passedOn   DateTime
  mgt14Filed DateTime?

  explanatoryStatementOnFile Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ClientValuation {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  valuationDate DateTime
  fmvPerShare   Float
  valuerName    String?

  signedBySebiCat1MerchantBanker Boolean @default(false)

  reference String?

  exercises RegisterExercise[]
  taxEvents TaxEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ImportBatch {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind     ImportKind
  fileName String
  rowCount Int

  mapping Json?

  grants   RegisterGrant[]
  capTable CapTableRow[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

model RegisterGrant {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  batchId String?
  batch   ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  sourceRow Int?

  employeeName String
  employeeRef  String?

  grantDate      DateTime
  optionsGranted Int
  exercisePrice  Float

  vestingStartDate DateTime?
  vestingMonths    Int?
  cliffMonths      Int?
  expiryDate       DateTime?

  postExitExerciseDays  Int?
  forfeitureTermsOnFile Boolean?

  optionsLapsed Int @default(0)

  status RegisterGrantStatus @default(ACTIVE)
  leftOn DateTime?

  letterOptions       Int?
  letterExercisePrice Float?
  letterGrantDate     DateTime?

  exercises RegisterExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([batchId])
}

model RegisterExercise {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  grantId String
  grant   RegisterGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  valuationId String?
  valuation   ClientValuation? @relation(fields: [valuationId], references: [id], onDelete: SetNull)

  exerciseDate     DateTime
  optionsExercised Int

  allotmentDate DateTime?
  pas3FiledOn   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([grantId])
}

model CapTableRow {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  batchId String?
  batch   ImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  holderName String
  holderType HolderType @default(OTHER)
  shares     Int

  createdAt DateTime @default(now())

  @@index([clientId])
}

model RuleDefinition {
  id String @id @default(cuid())

  code   String @unique
  title  String
  source String

  taxYear  String?
  verified Boolean @default(false)

  severityVerified   FindingSeverity @default(RED)
  severityUnverified FindingSeverity @default(AMBER)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiligenceRun {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  score Int

  rulesSnapshot Json?

  findings   DiligenceFinding[]
  shareLinks ShareLink[]

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

model DiligenceFinding {
  id String @id @default(cuid())

  runId String
  run   DiligenceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  ruleCode String
  severity FindingSeverity

  title  String
  detail String

  sourceRef      Json?
  suggestedOwner String?
  dueDate        DateTime?

  ruleVerified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([severity])
}

model ShareLink {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  runId String?
  run   DiligenceRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  tokenHash    String  @unique
  label        String?
  passcodeHash String?

  expiresAt DateTime
  revokedAt DateTime?

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdById String

  views ShareLinkView[]

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

model ShareLinkView {
  id String @id @default(cuid())

  linkId String
  link   ShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  ipHash    String?
  userAgent String?

  viewedAt DateTime @default(now())

  @@index([linkId])
}

// ============================================================
// TAX-EVENT LEDGER
// ============================================================

model TaxEmployee {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  employeeRef String?
  pan         String?

  regime TaxRegime @default(NEW)

  // Estimated annual taxable income for the year, excluding the ESOP perquisite
  estimatedIncomeExclPerq Float @default(0)

  // Net pay in the month TDS would be deducted from (null = not entered)
  monthlyNetPay Float?

  isPromoter Boolean @default(false)

  archivedAt DateTime?

  events TaxEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([archivedAt])
}

model TaxEvent {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  employeeId String
  employee   TaxEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      TaxEventType
  eventDate DateTime     @db.Date

  // Ignored for LEAVE
  shares Int @default(0)

  // EXERCISE
  exercisePrice Float?
  valuationId   String?
  valuation     ClientValuation? @relation(fields: [valuationId], references: [id], onDelete: SetNull)

  // SALE and BUYBACK
  pricePerShare Float?
  // Optionally pin a sale/buyback to one exercise (TaxEvent id); otherwise oldest lots first
  lotEventId String?

  note String?

  computations TaxComputation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([employeeId])
  @@index([eventDate])
}

// Append-only audit trail: every recompute stores the full result,
// its inputs and the rule-set version used.
model TaxComputation {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  eventId String
  event   TaxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ruleSetVersion String
  result         Json

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([eventId, createdAt])
}

// Founder-controlled verification flag for each tax rule code.
// Kept apart from RuleDefinition so Feature 1 report counts are unaffected.
model TaxRule {
  code String @id

  title  String
  source String
  notes  String?

  verified   Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per reminder actually sent, so a deadline is never emailed twice.
model TaxReminderLog {
  id String @id @default(cuid())

  clientId String
  client   ClientCompany @relation(fields: [clientId], references: [id], onDelete: Cascade)

  deadlineKey String
  offsetDays  Int
  sentTo      String

  status ReminderStatus @default(SENT)
  error  String?

  sentAt DateTime @default(now())

  @@unique([deadlineKey, offsetDays])
  @@index([clientId])
}
